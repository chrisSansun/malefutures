# Always revalidate CSS so edits show up immediately; fonts and images can be cached.
/assets/site.css
  Cache-Control: public, max-age=0, must-revalidate
/assets/mff.css
  Cache-Control: public, max-age=0, must-revalidate
/assets/inter-var.woff2
  Cache-Control: public, max-age=31536000, immutable
